# The setup the book's examples use. OpenAI() reads the first two on its
# own; OPENAI_BASE_URL is needed only when you call something other than
# OpenAI itself, such as a self-hosted model server or a gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# No default model is baked into the listings, so both must be set. Use
# identifiers your provider actually serves -- naming schemes differ
# between providers for the same underlying model.
CHAT_MODEL=
EMBED_MODEL=

# Alternative, for readers whose organization provides Azure OpenAI only.
# See "Using Azure OpenAI" in the setup appendix: the client construction
# differs, everything after it does not.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Web search examples in chapter 2
SERPER_API_KEY=
